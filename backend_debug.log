==>  Preparing: SELECT c.*, cc.contact_name AS primary_contact_name, cc.contact_mobile AS primary_contact_mobile, cc.contact_email AS primary_contact_email, (SELECT COUNT(*) FROM customer_contacts WHERE customer_id = c.id) AS contact_count, IFNULL(( SELECT SUM(IFNULL(so.total_amount, 0)) FROM sales_orders so WHERE so.is_deleted = 0 AND so.order_date >= DATE_FORMAT(DATE_SUB(CURDATE(), INTERVAL 1 MONTH), '%Y-%m-01') AND so.order_date < DATE_FORMAT(CURDATE(), '%Y-%m-01') AND ( so.customer COLLATE utf8mb4_unicode_ci = c.customer_code COLLATE utf8mb4_unicode_ci OR so.customer COLLATE utf8mb4_unicode_ci = c.customer_name COLLATE utf8mb4_unicode_ci OR (c.short_name IS NOT NULL AND c.short_name != '' AND so.customer COLLATE utf8mb4_unicode_ci = c.short_name COLLATE utf8mb4_unicode_ci) ) ), 0) AS last_month_sales_amount, IFNULL(( SELECT SUM(IFNULL(so2.total_amount, 0)) FROM sales_orders so2 WHERE so2.is_deleted = 0 AND so2.order_date >= DATE_FORMAT(CURDATE(), '%Y-01-01') AND so2.order_date < DATE_FORMAT(DATE_ADD(CURDATE(), INTERVAL 1 YEAR), '%Y-01-01') AND ( so2.customer COLLATE utf8mb4_unicode_ci = c.customer_code COLLATE utf8mb4_unicode_ci OR so2.customer COLLATE utf8mb4_unicode_ci = c.customer_name COLLATE utf8mb4_unicode_ci OR (c.short_name IS NOT NULL AND c.short_name != '' AND so2.customer COLLATE utf8mb4_unicode_ci = c.short_name COLLATE utf8mb4_unicode_ci) ) ), 0) AS this_year_sales_amount, IFNULL(( SELECT SUM( CASE WHEN IFNULL(soi.rolls, 0) > 0 THEN IFNULL(dni.quantity, 0) * IFNULL(soi.amount, 0) / NULLIF(soi.rolls, 0) WHEN IFNULL(soi.sqm, 0) > 0 THEN IFNULL(dni.area_size, 0) * IFNULL(soi.amount, 0) / NULLIF(soi.sqm, 0) ELSE 0 END ) FROM delivery_notices dn INNER JOIN delivery_notice_items dni ON dni.notice_id = dn.id INNER JOIN sales_order_items soi ON soi.id = dni.order_item_id AND soi.is_deleted = 0 WHERE dn.is_deleted = 0 AND ( UPPER(IFNULL(dn.status, '')) IN ('SHIPPED', 'RECEIVED') OR IFNULL(dn.status, '') IN ('已发货', '已收货') ) AND ( dn.customer COLLATE utf8mb4_unicode_ci = c.customer_code COLLATE utf8mb4_unicode_ci OR dn.customer COLLATE utf8mb4_unicode_ci = c.customer_name COLLATE utf8mb4_unicode_ci OR (c.short_name IS NOT NULL AND c.short_name != '' AND dn.customer COLLATE utf8mb4_unicode_ci = c.short_name COLLATE utf8mb4_unicode_ci) ) ), 0) AS shipped_amount, u1.real_name AS sales_user_name, u2.real_name AS documentation_person_user_name FROM customers c LEFT JOIN ( SELECT c1.customer_id, c1.contact_name, c1.contact_mobile, c1.contact_email FROM customer_contacts c1 INNER JOIN ( SELECT customer_id, MIN(id) AS pick_id FROM customer_contacts WHERE is_primary = 1 GROUP BY customer_id ) p ON p.pick_id = c1.id ) cc ON c.id = cc.customer_id LEFT JOIN users u1 ON c.sales = u1.id LEFT JOIN users u2 ON c.documentation_person = u2.id WHERE c.is_deleted = 0 AND ( c.sales = ? OR c.documentation_person = ? ) ORDER BY last_month_sales_amount DESC , c.create_time DESC LIMIT ?
