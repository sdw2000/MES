==>  Preparing: SELECT so.id, so.order_no, so.customer, so.customer_order_no, COALESCE(so.sales, c.sales) AS sales, COALESCE(so.documentation_person, c.documentation_person) AS documentation_person, so.total_amount, so.total_area, so.order_date, so.delivery_date, so.delivery_address, so.status, so.created_by, so.updated_by, so.created_at, so.updated_at, so.is_deleted, IFNULL(rp.completed_rolls, 0) AS shipped_rolls, CASE WHEN UPPER(IFNULL(so.status, '')) IN ('PAID','CLOSED','COMPLETED','RECEIVED','SHIPPED_FULL','RECONCILED','FULL_RECONCILED') OR IFNULL(so.status, '') IN ('已对账','对账完成','已结清') THEN 0 ELSE IFNULL(rp.remaining_rolls, 0) END AS remaining_rolls, IFNULL(rp.produced_rolls, 0) AS rp_produced_rolls, IFNULL(rp.shipped_rolls, 0) AS rp_shipped_rolls, CASE WHEN UPPER(IFNULL(so.status, '')) IN ('PAID','CLOSED','COMPLETED','RECEIVED','SHIPPED_FULL','RECONCILED','FULL_RECONCILED') OR IFNULL(so.status, '') IN ('已对账','对账完成','已结清') THEN 0 ELSE IFNULL(rp.unshipped_area, 0) END AS unshipped_area, CASE WHEN UPPER(IFNULL(so.status, '')) IN ('PAID','CLOSED','COMPLETED','RECEIVED','SHIPPED_FULL','RECONCILED','FULL_RECONCILED') OR IFNULL(so.status, '') IN ('已对账','对账完成','已结清') THEN 0 ELSE IFNULL(rp.unshipped_amount, 0) END AS unshipped_amount, (CASE WHEN UPPER(TRIM(IFNULL(so.customer, ''))) IN ('RP01','GDRP01','JSRP01','JXRP001','LZRP01','SHRP001') THEN (CASE WHEN UPPER(IFNULL(so.status, '')) IN ('PAID','CLOSED','COMPLETED','RECEIVED','SHIPPED_FULL','RECONCILED','FULL_RECONCILED') OR IFNULL(so.status, '') IN ('已对账','对账完成','已结清') THEN 0 ELSE GREATEST(IFNULL(rp.produced_rolls, 0) - IFNULL(rp.shipped_rolls, 0), 0) END) ELSE (CASE WHEN UPPER(IFNULL(so.status, '')) IN ('PAID','CLOSED','COMPLETED','RECEIVED','SHIPPED_FULL','RECONCILED','FULL_RECONCILED') OR IFNULL(so.status, '') IN ('已对账','对账完成','已结清') THEN 0 ELSE IFNULL(rp.remaining_rolls, 0) END) END) AS rp_shippable, COALESCE(su.real_name, '') as salesUserName, COALESCE(du.real_name, '') as documentationPersonUserName FROM sales_orders so LEFT JOIN customers c ON so.customer COLLATE utf8mb4_unicode_ci = c.customer_code COLLATE utf8mb4_unicode_ci LEFT JOIN ( SELECT soi.order_id, IFNULL(SUM(LEAST(IFNULL(soi.rolls, 0), IFNULL(shipped.confirmed_qty, 0))), 0) AS completed_rolls, IFNULL(SUM(GREATEST(IFNULL(soi.rolls, 0) - IFNULL(shipped.confirmed_qty, 0), 0)), 0) AS remaining_rolls, IFNULL(SUM(IFNULL(soi.delivered_qty, 0)), 0) AS produced_rolls, IFNULL(SUM(IFNULL(shipped.confirmed_qty, 0)), 0) AS shipped_rolls, IFNULL(SUM(CASE WHEN IFNULL(soi.rolls, 0) > 0 THEN GREATEST(IFNULL(soi.rolls, 0) - IFNULL(shipped.confirmed_qty, 0), 0) * IFNULL(soi.sqm, 0) / IFNULL(NULLIF(soi.rolls, 0), 1) ELSE GREATEST(IFNULL(soi.sqm, 0) - IFNULL(soi.delivered_area, 0), 0) END), 0) AS unshipped_area, IFNULL(SUM(CASE WHEN IFNULL(soi.rolls, 0) > 0 THEN GREATEST(IFNULL(soi.rolls, 0) - IFNULL(shipped.confirmed_qty, 0), 0) * IFNULL(soi.amount, 0) / IFNULL(NULLIF(soi.rolls, 0), 1) WHEN IFNULL(soi.sqm, 0) > 0 THEN GREATEST(IFNULL(soi.sqm, 0) - IFNULL(soi.delivered_area, 0), 0) * IFNULL(soi.amount, 0) / IFNULL(NULLIF(soi.sqm, 0), 1) ELSE 0 END), 0) AS unshipped_amount FROM sales_order_items soi LEFT JOIN ( SELECT dni.order_item_id, SUM(IFNULL(dni.quantity, 0)) AS confirmed_qty FROM delivery_notice_items dni INNER JOIN delivery_notices dn ON dn.id = dni.notice_id WHERE dn.is_deleted = 0 AND dn.status IN ('已发货', 'shipped', '已收货', 'received') GROUP BY dni.order_item_id ) shipped ON shipped.order_item_id = soi.id WHERE soi.is_deleted = 0 GROUP BY soi.order_id) rp ON rp.order_id = so.id LEFT JOIN users su ON COALESCE(so.sales, c.sales) = su.id LEFT JOIN users du ON COALESCE(so.documentation_person, c.documentation_person) = du.id WHERE so.is_deleted = 0 AND UPPER(IFNULL(so.status, '')) NOT IN ('RECEIVED','SHIPPED_FULL','PAID','CLOSED','CANCELLED','CANCELED','COMPLETED','RECONCILED','FULL_RECONCILED') AND IFNULL(so.status, '') NOT IN ('已对账','对账完成','已结清') ORDER BY so.order_date DESC LIMIT ?
