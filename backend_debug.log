<==        Row: 345, 1011-R02-2307-G03-0350A, 30μm无机翠绿PET终止胶带, G03, 30.00
==>  Preparing: SELECT COUNT(*) AS total FROM sales_orders so LEFT JOIN customers c ON so.customer COLLATE utf8mb4_unicode_ci = c.customer_code COLLATE utf8mb4_unicode_ci LEFT JOIN (SELECT soi.order_id, IFNULL(SUM(LEAST(IFNULL(soi.rolls, 0), IFNULL(shipped.confirmed_qty, 0))), 0) AS completed_rolls, IFNULL(SUM(GREATEST(IFNULL(soi.rolls, 0) - IFNULL(shipped.confirmed_qty, 0), 0)), 0) AS remaining_rolls, IFNULL(SUM(IFNULL(soi.delivered_qty, 0)), 0) AS produced_rolls, IFNULL(SUM(IFNULL(shipped.confirmed_qty, 0)), 0) AS shipped_rolls, IFNULL(SUM(CASE WHEN IFNULL(soi.rolls, 0) > 0 THEN GREATEST(IFNULL(soi.rolls, 0) - IFNULL(shipped.confirmed_qty, 0), 0) * IFNULL(soi.sqm, 0) / IFNULL(NULLIF(soi.rolls, 0), 1) ELSE GREATEST(IFNULL(soi.sqm, 0) - IFNULL(soi.delivered_area, 0), 0) END), 0) AS unshipped_area, IFNULL(SUM(CASE WHEN IFNULL(soi.rolls, 0) > 0 THEN GREATEST(IFNULL(soi.rolls, 0) - IFNULL(shipped.confirmed_qty, 0), 0) * IFNULL(soi.amount, 0) / IFNULL(NULLIF(soi.rolls, 0), 1) WHEN IFNULL(soi.sqm, 0) > 0 THEN GREATEST(IFNULL(soi.sqm, 0) - IFNULL(soi.delivered_area, 0), 0) * IFNULL(soi.amount, 0) / IFNULL(NULLIF(soi.sqm, 0), 1) ELSE 0 END), 0) AS unshipped_amount FROM sales_order_items soi LEFT JOIN (SELECT dni.order_item_id, SUM(IFNULL(dni.quantity, 0)) AS confirmed_qty FROM delivery_notice_items dni INNER JOIN delivery_notices dn ON dn.id = dni.notice_id WHERE dn.is_deleted = 0 AND dn.status IN ('已发货', 'shipped', '已收货', 'received') GROUP BY dni.order_item_id) shipped ON shipped.order_item_id = soi.id WHERE soi.is_deleted = 0 GROUP BY soi.order_id) rp ON rp.order_id = so.id LEFT JOIN users su ON COALESCE(so.sales, c.sales) = su.id LEFT JOIN users du ON COALESCE(so.documentation_person, c.documentation_person) = du.id WHERE so.is_deleted = 0 AND (so.sales = ? OR so.documentation_person = ? OR ((so.sales IS NULL AND so.documentation_person IS NULL) AND (c.sales = ? OR c.documentation_person = ?))) AND UPPER(IFNULL(so.status, '')) NOT IN ('RECEIVED', 'SHIPPED_FULL', 'PAID', 'CLOSED', 'CANCELLED', 'CANCELED', 'COMPLETED', 'RECONCILED', 'FULL_RECONCILED') AND IFNULL(so.status, '') NOT IN ('已对账', '对账完成', '已结清')
